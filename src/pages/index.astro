---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { SEO } from 'astro-seo';

const logo = new URL("/the-software-bakery.png", Astro.url);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<SEO
				title={SITE_TITLE}
				description={SITE_DESCRIPTION}
				openGraph={{
					basic: {
						title: SITE_TITLE,
						type: "website",
						description: SITE_DESCRIPTION,
						image: logo
					},
				}}
		/>
	</head>
	<body>
		<Header />
		<Hero />
		<main>
			<p>
				We're a small consultancy helping engineering teams ship faster by getting the platform layer right; the tooling, infrastructure, and workflows that decide how quickly and safely a team can move.
			</p>
			<p>
				We work with startups and scale-ups who want to invest in their platform without over-engineering it.
			</p>
			<p>
				Want to hear more? <a href="/contact">Drop me a message.</a>
			</p>
		</main>
		<Footer />
	</body>
</html>	
