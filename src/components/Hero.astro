---
---

<section class="hero">
	<div class="hero-inner">
		<h1>
			<span class="hero-first">Sensible</span>
			Platform Engineering  <br />
			<span class="hero-amp">&amp;</span> Developer Experience
		</h1>
		<a href="/contact" class="cta-button">Get in touch</a>
	</div>
</section>

<style>
	.hero {
		width: 100%;
	}
	.hero-inner {
		width: 800px;
		max-width: calc(100% - 2em);
		margin: auto;
		padding: 4em 1em 3em;
	}

	.hero h1 {
		font-size: 3.052em;
		line-height: 1.35;
		margin-bottom: 2.5rem;
	}

	.hero-first, .hero-amp {
		font-family: "Noto Serif";
		font-style: italic;
	}

	.hero-first {
		display: block;
	}

	.cta-button {
		display: inline-block;
		background-color: #fff;
		color: #000;
		text-decoration: none;
		padding: 0.6em 1.4em;
		border-radius: 4px;
		font-size: 1rem;
		font-weight: 600;
		transition: background-color 0.15s ease, color 0.15s ease;
	}
	.cta-button:hover {
		background-color: rgb(var(--gray-dark));
		color: #000;
	}
	@media (max-width: 720px) {
		.hero h1 {
			font-size: 2.441em;
		}
	}
</style>
